{
  "name": "dsh-annotate",
  "version": "0.2.3",
  "description": "Click any element in a live page preview inside the DSH sidebar, annotate or comment on it, and send it to the AI conversation as structured context — no screenshots, no guessing which element you meant.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "author": "TheYoungChen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheYoungChen/dsh-annotate.git"
  },
  "homepage": "https://github.com/TheYoungChen/dsh-annotate#readme",
  "bugs": {
    "url": "https://github.com/TheYoungChen/dsh-annotate/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "annotate",
    "annotation",
    "element-picker",
    "element-inspector",
    "visual-feedback",
    "ui-review",
    "web-preview",
    "devtools",
    "css-selector",
    "ai-agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-alpha.1": "compatible",
        "0.1.7-alpha.2": "compatible",
        "0.1.7-rc.1": "compatible"
      },
      "node": ">=20",
      "platforms": [
        "win32",
        "darwin",
        "linux"
      ],
      "profiles": [
        "web"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true }
  },
  "engines": {
    "node": ">=20"
  },
  "dshTarget": "0.1.5-rc.1"
}