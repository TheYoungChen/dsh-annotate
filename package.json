{
  "name": "dsh-annotate",
  "version": "0.1.0",
  "description": "Annotate and comment on any web element in a live preview inside the DSH sidebar, then send it to the conversation as one structured block.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "author": "TheYoungChen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheYoungChen/dsh-annotate.git"
  },
  "homepage": "https://github.com/TheYoungChen/dsh-annotate#readme",
  "bugs": {
    "url": "https://github.com/TheYoungChen/dsh-annotate/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "annotate",
    "annotation",
    "review",
    "devtools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true }
  },
  "engines": {
    "node": ">=20"
  },
  "dshTarget": "0.1.5-rc.1"
}